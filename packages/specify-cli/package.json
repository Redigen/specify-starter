{
  "name": "specify-cli",
  "version": "0.1.0",
  "description": "YAML<->JSON bridge for AI agents working with Specify specs. Validates against JSON Schemas declared in .vscode/settings.json (yaml.schemas).",
  "type": "module",
  "bin": {
    "specify-cli": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "specify",
    "yaml",
    "json",
    "schema",
    "validation",
    "ai",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.0",
    "jsonc-parser": "^3.3.1",
    "minimatch": "^10.0.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
